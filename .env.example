# Copy to .env and fill in secrets. Do not commit .env.
#   cp .env.example .env

# --- Required for Gemini judges / MemAlign reflection + embeddings ---
GEMINI_API_KEY=

# --- Only if you override MEMALIGN_EMBEDDING_MODEL to an openai:/ URI ---
OPENAI_API_KEY=

# --- Agent (LMStudio / local Qwen) ---
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_API_KEY=lm-studio
AGENT_MODEL=qwen/qwen3.6-35b-a3b

# --- MLflow ---
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=edd-financial-assistant

# --- Judge / MemAlign model URIs (MLflow provider:/model format) ---
JUDGE_MODEL=gemini:/gemini-2.5-pro
MEMALIGN_REFLECTION_LM=gemini:/gemini-2.5-flash
# Uses GEMINI_API_KEY via LiteLLM (gemini/text-embedding-004).
# Alternative: gemini:/gemini-embedding-001
MEMALIGN_EMBEDDING_MODEL=gemini:/text-embedding-004

# --- Version tags ---
AGENT_VERSION=0.1.0
DATASET_VERSION=v1
